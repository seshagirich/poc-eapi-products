#%RAML 1.0
title: poc-eapi-products
protocols:
  - HTTP
  - HTTPS
version: v1


traits:
  Client-ID-Policy: !include /examples/price-trait.raml

/v1:
  /prices:
    post:
      is: [Client-ID-Policy]
      body:
        application/json:
          type: !include datatypes/price-request-dataType.raml
          example: !include examples/price-request-file.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/price-response-dataType.raml
              example: !include examples/price-response-file.json
                
  /stock:
    post:
      is: [Client-ID-Policy]
      body:
        application/json:
          type: !include datatypes/stock-request-dataType.raml
          example:  !include examples/stock-request-file.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/stock-response-dataType.raml
              example: !include examples/stock-response-file.json
                
  /tax:
    post:
      body:
        application/json:
          type: !include datatypes/tax-request-dataType.raml
          example: !include examples/tax-request-file.json
      responses:
        200:
          body:
            application/json:
              example: !include examples/tax-response-file.json


  /customer:
    post:
      is: [Client-ID-Policy]
      body:
        application/json:
          type: !include datatypes/customer-request-dataType.raml
          example: !include examples/customer-request-file.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/customer-response-dataType.raml
              example: !include examples/customer-response-file.json      
            

        