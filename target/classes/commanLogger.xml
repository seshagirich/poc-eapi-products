		<ee:transform doc:name="Transform Message" doc:id="a2c637f5-8df9-4095-a7b8-5fadef592595" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="endFlow" ><![CDATA[%dw 2.0
output application/json
---
{
	"flowName": vars.flowName,
	"status": "endFlow",
	"correlationID": correlationId
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="81a9622f-1998-4c20-afdf-31414dc628a0" />
	</sub-flow>
</mule>
