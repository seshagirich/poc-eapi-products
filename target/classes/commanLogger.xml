		<ee:transform doc:name="Transform Message" doc:id="c3ce66e3-93de-4351-a88d-db6129accee7" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="startFlow" ><![CDATA[%dw 2.0
output application/json
---
{
	flowname: vars.flowName,
	status: "startFlow",
	correlationId: correlationId
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="vars.startFlow" doc:id="647dfe63-98c6-47ba-a7da-51006c2fe894" message="#[vars.startFlow]"/>
